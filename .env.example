# Firebase Client SDK (public, used in browser)
VITE_APIKEY=
VITE_AUTH_DOMAIN=
VITE_DATABASE_URL=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
VITE_SITE_URL=

# YouTube Data API v3 (server-side only, keep secret)
# Console > APIs & Services > Credentials > Create API key, then enable
# "YouTube Data API v3" for the project. Without this the site falls back to
# the bundled episode list in src/lib/data/videos.js.
YOUTUBE_API_KEY=
# Optional — overrides the series playlist that /videos and the landing page read.
YOUTUBE_PLAYLIST_ID=

# Firebase Admin SDK (server-side only, keep secret)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON service account key as a single line
FIREBASE_ADMIN_SERVICE_KEY={}
